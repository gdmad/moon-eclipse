{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "lib": ["DOM", "WebWorker", "ES2020"],
    "moduleResolution": "bundler",
    "module": "ES2020",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
