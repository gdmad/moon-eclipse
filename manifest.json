{
    "manifest_version": 2,
    "name": "Moon Eclipse",
    "version": "1.3.0",
    "description": "Dark theme for any website — lightweight, fast, lunar-inspired.",
    "permissions": ["storage", "alarms", "activeTab"],
    "background": {
        "scripts": ["dist/background.js"],
        "persistent": false
    },
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*"],
            "js": ["dist/content.js"],
            "run_at": "document_start",
            "all_frames": false
        }
    ],
    "browser_action": {
        "default_popup": "src/popup/popup.html",
        "default_title": "Moon Eclipse"
    },
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "64": "icons/icon-64.png",
        "96": "icons/icon-96.png",
        "128": "icons/icon-128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "{365a54a0-542e-443a-85d9-2f9e8c790029}",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}
